{
  "name": "@lidr/design-system",
  "private": false,
  "version": "1.0.0",
  "description": "Lidr Design System - Modern React components with TypeScript",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./styles": "./dist/index.css",
    "./tailwind": "./tailwind.config.cjs"
  },
  "files": [
    "dist",
    "src",
    "tailwind.config.cjs",
    "README.md",
    "DESIGN_SYSTEM.md"
  ],
  "keywords": [
    "react",
    "typescript",
    "design-system",
    "ui-components",
    "tailwindcss",
    "storybook"
  ],
  "author": "Lidr Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LIDR-academy/frontend-use-case-design-system"
  },
  "bugs": {
    "url": "https://github.com/LIDR-academy/frontend-use-case-design-system/issues"
  },
  "homepage": "https://github.com/LIDR-academy/frontend-use-case-design-system#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:e2e",
    "test:install": "playwright install --with-deps",
    "test:e2e": "playwright test e2e/storybook/ -c playwright.config.ts --project=chromium",
    "test:e2e:all": "playwright test e2e/storybook/ -c playwright.config.ts",
    "test:e2e:headed": "playwright test e2e/storybook/ -c playwright.config.ts --project=chromium --headed",
    "test:e2e:ui": "playwright test e2e/storybook/ -c playwright.config.ts --ui",
    "test:e2e:debug": "playwright test e2e/storybook/ -c playwright.config.ts --project=chromium --debug",
    "test:e2e:update-snapshots": "playwright test e2e/storybook/visual.spec.ts -c playwright.config.ts --update-snapshots",
    "test:ct": "playwright test -c playwright-ct.config.ts",
    "test:report": "playwright show-report playwright-report/e2e",
    "test:report:ct": "playwright show-report playwright-report/ct",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "build:lib": "rollup -c",
    "prepublishOnly": "npm run build:lib && npm run build-storybook",
    "release": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/js": "^9.33.0",
    "@playwright/experimental-ct-react": "^1.56.1",
    "@playwright/test": "^1.56.1",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@storybook/addon-a11y": "^7.6.20",
    "@storybook/addon-essentials": "^7.6.20",
    "@storybook/addon-interactions": "^7.6.20",
    "@storybook/addon-links": "^7.6.20",
    "@storybook/addon-onboarding": "^1.0.11",
    "@storybook/blocks": "^7.6.20",
    "@storybook/jest": "^0.2.2",
    "@storybook/react": "^7.6.20",
    "@storybook/react-vite": "^7.6.20",
    "@storybook/testing-library": "^0.2.1",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "chromatic": "^13.1.5",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "rollup": "^4.50.2",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "storybook": "^7.6.20",
    "storybook-dark-mode": "^4.0.2",
    "tailwindcss": "^3.4.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^4.3.9"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended",
      "plugin:storybook/recommended"
    ]
  }
}
